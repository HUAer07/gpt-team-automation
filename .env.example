# ==========================================
# ChatGPT Team 自动化配置
# ==========================================

# ==========================================
# Web 控制台公网安全访问控制 (HTTP Basic Auth)
# 部署至公网服务器时务必设置，防止未授权访问窃取账密与卡号
# ==========================================
WEB_USERNAME=admin
WEB_PASSWORD=admin8888

# 住宅代理配置 (强烈建议配置，格式: http://user:pass@host:port 或 socks5://...)
HTTP_PROXY=

# 运行模式: true 为无头后台静默运行，false 为打开浏览器窗口方便本地观察调试
HEADLESS=false

# 步骤间随机防风控延迟（秒，推荐 15-30）
STEP_DELAY_SECONDS=15

# --- 母号配置 (负责开通支付，发起邀请，转移所有权) ---
MASTER_EMAIL=master_account@example.com
MASTER_PASSWORD=YourPasswordHere
# 2FA 密钥 (Base32，Authenticator app 生成密钥，无空格)
MASTER_TOTP_SECRET=JBSWY3DPEHPK3PXP

# --- 子号配置 (接受邀请，成为 Primary Owner，最终留存) ---
CHILD_EMAIL=child_account@example.com
CHILD_PASSWORD=YourPasswordHere
CHILD_TOTP_SECRET=KZXW6YTBOI6Q2YZZ

# --- 打码平台配置 (Arkose Labs 拼图 / Turnstile / hCaptcha 全自动过盾) ---
YESCAPTCHA_KEY=
# CAPSOLVER_KEY=可选项，针对星空找不同图标等极端视觉题识别率更高

# 支付专用住宅代理 (若留空则走全局 HTTP_PROXY，建议使用干净的当地原生住宅 IP)
# CHECKOUT_PROXY=

# --- 协议支付配置 (绑卡 mandate -> 协议 confirm -> 落库复用) ---
# 卡信息仅存本机 .env；mandate 落库只保留卡尾号与 pm_xxx，不存全文卡号
CARD_NUMBER=
CARD_EXP=12/29
CARD_CVC=
CARD_NAME=ChatGPT User
AUTO_PAY=false

# 账单地址 (默认特拉华 DE 免税州，需与出口 IP 地区一致)
BILLING_COUNTRY=US
BILLING_LINE1=1201 N Orange St
BILLING_CITY=Wilmington
BILLING_STATE=DE
BILLING_ZIP=19801

# 协议支付引擎开关
# PAYMENT_PROTOCOL=0                 关闭协议通道，全部走旧 UI 填表
# PAYMENT_PROTOCOL_SETUP_INTENT=0    跳过 SetupIntent(off_session) 建单，只做 pm + confirm
# PAYMENT_PROTOCOL_UI_FALLBACK=0     协议失败时不回落 UI（严格协议模式）
# PAYMENT_MANDATE_DIR=./data/mandates  mandate 落库目录
