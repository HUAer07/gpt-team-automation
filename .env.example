# ==========================================
# ChatGPT Team 自动化配置
# ==========================================

# 住宅代理配置 (强烈建议配置，格式: http://user:pass@host:port 或 socks5://...)
HTTP_PROXY=

# 运行模式: true 为无头后台静默运行，false 为打开浏览器窗口方便本地观察调试
HEADLESS=false

# 步骤间随机防风控延迟（秒，推荐 15-30）
STEP_DELAY_SECONDS=15

# --- 母号配置 (负责开通支付，发起邀请，转移所有权) ---
MASTER_EMAIL=master_account@example.com
MASTER_PASSWORD=YourPasswordHere
# 2FA 密钥 (Base32，Authenticator app 生成密钥，无空格)
MASTER_TOTP_SECRET=JBSWY3DPEHPK3PXP

# --- 子号配置 (接受邀请，成为 Primary Owner，最终留存) ---
CHILD_EMAIL=child_account@example.com
CHILD_PASSWORD=YourPasswordHere
CHILD_TOTP_SECRET=KZXW6YTBOI6Q2YZZ
